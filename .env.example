# Grasshopper Server Configuration
# Set this to your public tunnel URL when using ngrok/localtunnel for remote access
# Leave empty or use localhost for local development
NEXT_PUBLIC_GH_SERVER_URL=

# Feature Flags
# Enable drag-and-drop reordering of input/output parameters
NEXT_PUBLIC_ENABLE_DRAG_DROP_REORDER=true

# Deployment Instructions:
# 1. Copy this file to .env.local and set your values
# 2. For Vercel deployment with remote Grasshopper server:
#    - Set NEXT_PUBLIC_GH_SERVER_URL to your ngrok/tunnel URL
#    - Example: NEXT_PUBLIC_GH_SERVER_URL=https://abc123.ngrok.app
# 3. For local development:
#    - Leave NEXT_PUBLIC_GH_SERVER_URL empty (defaults to localhost:9998)